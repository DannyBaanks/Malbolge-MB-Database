/* mbir_m2_loader.hell — Stored-Program MBIR VM with Dedicated Return Flags */
.CODE
MOVED:
	MovD/Nop
	Jmp

ROT:
	Rot/Nop
	Jmp

IN:
	In/Nop
	Jmp

OUT:
	Out/Nop
	Jmp

CRAZY:
	Opr/Nop
	Jmp

HALT:
	Hlt

NOP:
	Jmp

COUNTER2_1:
	MovD/Nop
	Jmp

COUNTER2_2:
	Nop/MovD
	Jmp

COUNTER5_1:
	Nop/Nop/Nop/Nop/MovD
	Jmp

// Subroutine return flags for decrement_value
SUBROUTINE_FLAG1:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG2:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG3:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG4:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG5:
	Nop/MovD
	Jmp

OPCODE_C1:
	Nop/MovD
	Jmp

OPCODE_VAL:
	Nop/MovD
	Jmp

FLAG_P3_R1:
	Nop/MovD
	Jmp

FLAG_OP2_IS_1:
	Nop/MovD
	Jmp

FLAG_OP2_IS_2:
	Nop/MovD
	Jmp

FLAG_OP2_IS_3:
	Nop/MovD
	Jmp

SUB_FLAG:
	Nop/MovD
	Jmp

CMP_MODE:
	Nop/MovD
	Jmp

CMP_LT_MODE:
	Nop/MovD
	Jmp


// Internal flags for decrement_value
FLAG_DEC_TMP3:
	Nop/MovD
	Jmp

FLAG_DEC_TMP4:
	Nop/MovD
	Jmp

FLAG_DEC_VAL8:
	Nop/MovD
	Jmp

FLAG_DEC_VAL9:
	Nop/MovD
	Jmp

FLAG_DEC_CARRY2:
	Nop/MovD
	Jmp

// Initialization flag (used once per variable at ENTRY)
FLAG_INIT:
	Nop/MovD
	Jmp

// Dedicated storage return flags
FLAG_S0_STORE:
	Nop/MovD
	Jmp

FLAG_P0_STORE:
	Nop/MovD
	Jmp

FLAG_S1_STORE:
	Nop/MovD
	Jmp

FLAG_P1_STORE:
	Nop/MovD
	Jmp

FLAG_S2_STORE:
	Nop/MovD
	Jmp

FLAG_P2_STORE:
	Nop/MovD
	Jmp

FLAG_S3_STORE:
	Nop/MovD
	Jmp

FLAG_P3_STORE:
	Nop/MovD
	Jmp

// Dedicated read return flags
FLAG_P1_R1:
	Nop/MovD
	Jmp

FLAG_P1_R2:
	Nop/MovD
	Jmp

FLAG_P2_R1:
	Nop/MovD
	Jmp

FLAG_P2_R2:
	Nop/MovD
	Jmp

// Stack push/pop return flags
FLAG_SS_PUSH:
	Nop/MovD
	Jmp

FLAG_ST_PUSH:
	Nop/MovD
	Jmp

FLAG_ST_POP1:
	Nop/MovD
	Jmp

FLAG_ST_POP2:
	Nop/MovD
	Jmp

// Value C1 and Value load return flags
FLAG_VAL_C1_P2:
	Nop/MovD
	Jmp

FLAG_VAL_P2:
	Nop/MovD
	Jmp

FLAG_VAL_C1_LOAD:
	Nop/MovD
	Jmp

FLAG_VAL_LOAD:
	Nop/MovD
	Jmp

FLAG_VAL_C1_DEC3:
	Nop/MovD
	Jmp

FLAG_VAL_DEC3:
	Nop/MovD
	Jmp

// Decrement loop counters
LOOP2:
	Nop/MovD
	Jmp

LOOP2_2:
	Nop/MovD
	Jmp

LOOP2_3:
	Nop/MovD
	Jmp

LOOP5:
	Nop/Nop/Nop/Nop/MovD
	Jmp

NO_MORE_CARRY_FLAG:
	Nop/MovD
	Jmp

@C21 CARRY:
	RNop
	RNop
	Jmp

.DATA
crazy_value:
	U_CRAZY value
rot_value:
	U_ROT value
value:
	C1
	FLAG_VAL_LOAD ret_val_load R_FLAG_VAL_LOAD
	FLAG_VAL_DEC3 ret_val_dec3 R_FLAG_VAL_DEC3
	FLAG_DEC_VAL8 return_from_value_8 R_FLAG_DEC_VAL8
	FLAG_DEC_VAL9 return_from_value_9
	OPCODE_VAL ret_opcode_val R_OPCODE_VAL

crazy_value_C1:
	U_CRAZY value_C1
value_C1:
	C1
	FLAG_VAL_C1_LOAD ret_val_c1_load R_FLAG_VAL_C1_LOAD
	FLAG_VAL_C1_DEC3 ret_val_c1_dec3 R_FLAG_VAL_C1_DEC3
	OPCODE_C1 ret_opcode_c1 R_OPCODE_C1

crazy_tmp:
	U_CRAZY tmp
tmp:
	C0
	FLAG_DEC_TMP3 return_from_tmp_3 R_FLAG_DEC_TMP3
	FLAG_DEC_TMP4 return_from_tmp_4

crazy_carry:
	U_CRAZY carry
exec_carry:
	R_MOVED
carry:
	CARRY
	U_NOP execution_not_jumped_to_carry
	U_NOP carry_was_not_set U_NOP carry_was_set
carry_was_set:
	MOVED return_carry_was_set
carry_was_not_set:
	MOVED return_carry_was_not_set
execution_not_jumped_to_carry:
	FLAG_DEC_CARRY2 return_from_carry_2 R_FLAG_DEC_CARRY2
return_carry_was_set:
	FLAG_DEC_CARRY2 return_from_carry_was_set_2 R_FLAG_DEC_CARRY2
return_carry_was_not_set:
	FLAG_DEC_CARRY2 return_from_carry_was_not_set_2

// RAM and scratch cells
scratch_0_crazy:
	U_CRAZY scratch_0
scratch_0:
	?
	FLAG_INIT ret_s0_init R_FLAG_INIT
	FLAG_S0_STORE ret_s0_store R_FLAG_S0_STORE

prog_0_crazy:
	U_CRAZY prog_0
prog_0:
	?
	FLAG_INIT ret_p0_init R_FLAG_INIT
	FLAG_P0_STORE ret_p0_store R_FLAG_P0_STORE

scratch_1_crazy:
	U_CRAZY scratch_1
scratch_1:
	?
	FLAG_INIT ret_s1_init R_FLAG_INIT
	FLAG_S1_STORE ret_s1_store R_FLAG_S1_STORE

prog_1_crazy:
	U_CRAZY prog_1
prog_1:
	?
	FLAG_INIT ret_p1_init R_FLAG_INIT
	FLAG_P1_STORE ret_p1_store R_FLAG_P1_STORE
	FLAG_P1_R1 ret_p1_read1 R_FLAG_P1_R1
	FLAG_P1_R2 ret_p1_read2 R_FLAG_P1_R2

scratch_2_crazy:
	U_CRAZY scratch_2
scratch_2:
	?
	FLAG_INIT ret_s2_init R_FLAG_INIT
	FLAG_S2_STORE ret_s2_store R_FLAG_S2_STORE

prog_2_crazy:
	U_CRAZY prog_2
prog_2:
	?
	FLAG_INIT ret_p2_init R_FLAG_INIT
	FLAG_P2_STORE ret_p2_store R_FLAG_P2_STORE

scratch_3_crazy:
	U_CRAZY scratch_3
scratch_3:
	?
	FLAG_INIT ret_s3_init R_FLAG_INIT
	FLAG_S3_STORE ret_s3_store R_FLAG_S3_STORE

prog_3_crazy:
	U_CRAZY prog_3
prog_3:
	?
	FLAG_INIT ret_p3_init R_FLAG_INIT
	FLAG_P3_STORE ret_p3_store R_FLAG_P3_STORE
	FLAG_P3_R1 ret_op2_c1 R_FLAG_P3_R1

stack_scratch_crazy:
	U_CRAZY stack_scratch
stack_scratch:
	?
	FLAG_INIT ret_ss_init R_FLAG_INIT
	FLAG_SS_PUSH ret_ss_push R_FLAG_SS_PUSH

stack_top_crazy:
	U_CRAZY stack_top
stack_top:
	?
	FLAG_INIT ret_st_init R_FLAG_INIT
	FLAG_ST_PUSH ret_st_push R_FLAG_ST_PUSH
	FLAG_ST_POP1 ret_st_pop1 R_FLAG_ST_POP1
	FLAG_ST_POP2 ret_st_pop2 R_FLAG_ST_POP2

scratch_4_crazy:
	U_CRAZY scratch_4
scratch_4:
	C1
	FLAG_INIT ret_s4_init R_FLAG_INIT
	FLAG_S3_STORE ret_s4_store R_FLAG_S3_STORE

prog_4_crazy:
	U_CRAZY prog_4
prog_4:
	C1
	FLAG_INIT ret_p4_init R_FLAG_INIT
	FLAG_P3_STORE ret_p4_store R_FLAG_P3_STORE

scratch_5_crazy:
	U_CRAZY scratch_5
scratch_5:
	C1
	FLAG_INIT ret_s5_init R_FLAG_INIT
	FLAG_S3_STORE ret_s5_store R_FLAG_S3_STORE

prog_5_crazy:
	U_CRAZY prog_5
prog_5:
	C1
	FLAG_INIT ret_p5_init R_FLAG_INIT
	FLAG_P3_STORE ret_p5_store R_FLAG_P3_STORE

scratch_6_crazy:
	U_CRAZY scratch_6
scratch_6:
	C1
	FLAG_INIT ret_s6_init R_FLAG_INIT
	FLAG_S3_STORE ret_s6_store R_FLAG_S3_STORE

prog_6_crazy:
	U_CRAZY prog_6
prog_6:
	C1
	FLAG_INIT ret_p6_init R_FLAG_INIT
	FLAG_P3_STORE ret_p6_store R_FLAG_P3_STORE

{
ENTRY:
	ROT C1 R_ROT
do_init_s0:
	R_FLAG_INIT
	MOVED scratch_0_crazy
}{
ret_s0_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s0

do_init_p0:
	R_FLAG_INIT
	MOVED prog_0_crazy
}{
ret_p0_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p0

do_init_s1:
	R_FLAG_INIT
	MOVED scratch_1_crazy
}{
ret_s1_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s1

do_init_p1:
	R_FLAG_INIT
	MOVED prog_1_crazy
}{
ret_p1_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p1

do_init_s2:
	R_FLAG_INIT
	MOVED scratch_2_crazy
}{
ret_s2_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s2

do_init_p2:
	R_FLAG_INIT
	MOVED prog_2_crazy
}{
ret_p2_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p2

do_init_s3:
	R_FLAG_INIT
	MOVED scratch_3_crazy
}{
ret_s3_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s3

do_init_p3:
	R_FLAG_INIT
	MOVED prog_3_crazy
}{
ret_p3_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p3

do_init_ss:
	R_FLAG_INIT
	MOVED stack_scratch_crazy
}{
ret_ss_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_ss

do_init_st:
	R_FLAG_INIT
	MOVED stack_top_crazy
}{
ret_st_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_st

do_init_s4:
	R_FLAG_INIT
	MOVED scratch_4_crazy
}{
ret_s4_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s4

do_init_p4:
	R_FLAG_INIT
	MOVED prog_4_crazy
}{
ret_p4_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p4

do_init_s5:
	R_FLAG_INIT
	MOVED scratch_5_crazy
}{
ret_s5_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s5

do_init_p5:
	R_FLAG_INIT
	MOVED prog_5_crazy
}{
ret_p5_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p5

do_init_s6:
	R_FLAG_INIT
	MOVED scratch_6_crazy
}{
ret_s6_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_s6

do_init_p6:
	R_FLAG_INIT
	MOVED prog_6_crazy
}{
ret_p6_init:
	R_CRAZY R_MOVED
	COUNTER2_1 do_init_p6

	MOVED load_prog_0
}{
load_prog_0:
	R_MOVED
	IN ?- R_IN
	R_FLAG_S0_STORE
	MOVED scratch_0_crazy
}{
ret_s0_store:
	R_CRAZY R_MOVED
	R_FLAG_P0_STORE
	MOVED prog_0_crazy
}{
ret_p0_store:
	R_CRAZY R_MOVED
	// Copy byte 0 to value to test for HALT (0x00)
	R_FLAG_VAL_C1_LOAD
	MOVED crazy_value_C1
}{
ret_val_c1_load:
	R_CRAZY R_MOVED
	R_FLAG_VAL_LOAD
	MOVED crazy_value
}{
ret_val_load:
	R_CRAZY R_MOVED
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
return_from_decrement_value_1:
	NO_MORE_CARRY_FLAG load_prog_1
	HALT
}{
load_prog_1:
	IN ?- R_IN
	R_FLAG_S1_STORE
	MOVED scratch_1_crazy
}{
ret_s1_store:
	R_CRAZY R_MOVED
	R_FLAG_P1_STORE
	MOVED prog_1_crazy
}{
ret_p1_store:
	R_CRAZY R_MOVED
	IN ?- R_IN
	R_FLAG_S2_STORE
	MOVED scratch_2_crazy
}{
ret_s2_store:
	R_CRAZY R_MOVED
	R_FLAG_P2_STORE
	MOVED prog_2_crazy
}{
ret_p2_store:
	R_CRAZY R_MOVED
	// Byte 2 is in A! Check if byte 2 is 0x00 (Vector 4: 01 41 00)
	R_FLAG_VAL_C1_DEC3
	MOVED crazy_value_C1
}{
ret_val_c1_dec3:
	R_CRAZY R_MOVED
	R_FLAG_VAL_DEC3
	MOVED crazy_value
}{
ret_val_dec3:
	R_CRAZY R_MOVED
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
return_from_decrement_value_2:
	NO_MORE_CARRY_FLAG load_prog_3
	HALT
}{
load_prog_3:
	IN ?- R_IN
	R_FLAG_S3_STORE
	MOVED scratch_3_crazy
}{
ret_s3_store:
	R_CRAZY R_MOVED
	R_FLAG_P3_STORE
	MOVED prog_3_crazy
}{
ret_p3_store:
	R_CRAZY R_MOVED
	// byte 4 = opcode (0x02 ADD / 0x03 SUB / 0x04 CMP_EQ / 0x05 CMP_LT)
	R_FLAG_S3_STORE
	MOVED scratch_4_crazy
}{
ret_s4_store:
	R_CRAZY R_MOVED
	R_FLAG_P3_STORE
	MOVED prog_4_crazy
}{
ret_p4_store:
	R_CRAZY R_MOVED
	// byte 5 y byte 6 (OUT y HALT): reusan secuencialmente los mismos flags
	R_FLAG_S3_STORE
	MOVED scratch_5_crazy
}{
ret_s5_store:
	R_CRAZY R_MOVED
	R_FLAG_P3_STORE
	MOVED prog_5_crazy
}{
ret_p5_store:
	R_CRAZY R_MOVED
	R_FLAG_S3_STORE
	MOVED scratch_6_crazy
}{
ret_s6_store:
	R_CRAZY R_MOVED
	R_FLAG_P3_STORE
	MOVED prog_6_crazy
}{
ret_p6_store:
	R_CRAZY R_MOVED
	// despachar sobre el opcode: copiarlo a value_C1 y a value.
	// Se usan flags propios (OPCODE_C1/OPCODE_VAL) con líneas de prueba en
	// las celdas value_C1 y value, para no colisionar con las comprobaciones
	// de HALT del cargador.
	R_OPCODE_C1
	MOVED crazy_value_C1
}{
ret_opcode_c1:
	R_CRAZY R_MOVED
	R_OPCODE_VAL
	MOVED crazy_value
}{
ret_opcode_val:
	R_CRAZY R_MOVED
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{

// Vector 4 execution: push operand from prog_1 and HALT
exec_v4_push:
	R_MOVED
	ROT C2 R_ROT
	R_FLAG_P1_R1
	MOVED prog_1_crazy
}{
ret_v4_p1_r1:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_FLAG_P1_R2
	MOVED prog_1_crazy
}{
ret_v4_p1_r2:
	R_CRAZY R_MOVED
	R_FLAG_SS_PUSH
	MOVED stack_scratch_crazy
}{
ret_v4_ss_push:
	R_CRAZY R_MOVED
	R_FLAG_ST_PUSH
	MOVED stack_top_crazy
}{
ret_v4_st_push:
	R_CRAZY R_MOVED
	HALT
}{

// Vector 1 & 2 execution: push operand, pop operand, OUT, HALT
exec_v1_v2_push:
	R_MOVED
	ROT C2 R_ROT
	R_FLAG_P1_R1
	MOVED prog_1_crazy
}{
ret_p1_read1:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_FLAG_P1_R2
	MOVED prog_1_crazy
}{
ret_p1_read2:
	R_CRAZY R_MOVED
	R_FLAG_SS_PUSH
	MOVED stack_scratch_crazy
}{
ret_ss_push:
	R_CRAZY R_MOVED
	R_FLAG_ST_PUSH
	MOVED stack_top_crazy
}{
ret_st_push:
	R_CRAZY R_MOVED
	// Pop from stack and output:
	ROT C2 R_ROT
	R_FLAG_ST_POP1
	MOVED stack_top_crazy
}{
ret_st_pop1:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_FLAG_ST_POP2
	MOVED stack_top_crazy
}{
ret_st_pop2:
	R_CRAZY R_MOVED
	OUT ?- R_OUT
	HALT
}{

// ==========================================
// DECREMENT SUBROUTINE
// ==========================================
decrement_value:
	NO_MORE_CARRY_FLAG nomorecarrykilled_2 R_NO_MORE_CARRY_FLAG
nomorecarrykilled_2:
	R_MOVED
	ROT C1 R_ROT
	R_FLAG_DEC_TMP3
	MOVED crazy_tmp

return_from_tmp_3:
	R_CRAZY
value_load_loop:
	ROT C2 R_ROT
jmp_into_loop_from_behind:
	R_MOVED
	R_FLAG_DEC_VAL8
	MOVED crazy_value

return_from_value_8:
	R_CRAZY R_MOVED
	LOOP2 value_loaded
	MOVED value_load_loop

value_loaded:
	LOOP2_2 jump_back_to_behind
	R_FLAG_DEC_TMP4
	MOVED crazy_tmp

return_from_tmp_4:
	R_CRAZY R_MOVED
	R_FLAG_DEC_CARRY2
	MOVED crazy_carry

return_from_carry_2:
	R_CRAZY R_MOVED
	MOVED jmp_into_loop_from_behind

jump_back_to_behind:
	R_FLAG_DEC_CARRY2
	MOVED exec_carry

return_from_carry_was_not_set_2:
	R_NO_MORE_CARRY_FLAG
return_from_carry_was_set_2:
	R_MOVED
	R_FLAG_DEC_VAL9
	MOVED rot_value

return_from_value_9:
	R_MOVED R_ROT
	LOOP5 exit_inner_decrement_loop
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value

exit_inner_decrement_loop:
	LOOP2_3 exit_decrement_loop
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value

restore_no_more_carry_flag_and_rotate_value_2:
	R_NO_MORE_CARRY_FLAG
	MOVED return_from_carry_was_set_2


// ==========================================
// CLASIFICACION DEL OPCODE (dec 1..5)
// 0x02 -> carry en dec3 | 0x03 -> carry en dec4
// 0x04 -> carry en dec5 | 0x05 -> carry en dec6
// ==========================================
ret_opcode_dec1:
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
ret_opcode_dec2:
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
ret_opcode_dec3:
	NO_MORE_CARRY_FLAG opcode_ge_4
	MOVED opcode_is_add
}{
opcode_is_add:
	MOVED eval_pop
}{
opcode_ge_4:
	R_SUBROUTINE_FLAG4
	MOVED decrement_value
}{
ret_opcode_dec4:
	NO_MORE_CARRY_FLAG opcode_ge_5
	MOVED opcode_is_sub
}{
opcode_is_sub:
	R_SUB_FLAG
	MOVED eval_pop
}{
opcode_ge_5:
	R_SUBROUTINE_FLAG5
	MOVED decrement_value
}{
ret_opcode_dec5:
	NO_MORE_CARRY_FLAG opcode_ge_6
	MOVED opcode_is_cmp_eq
}{
opcode_is_cmp_eq:
	R_CMP_MODE
	MOVED eval_pop
}{
opcode_ge_6:
	// 0x05 y superiores: no soportados por esta imagen
	HALT
}{

// ==========================================
// EVALUACION: clasificar op2 (prog_3) y op1 (prog_1), seleccionar resultado
// ==========================================
eval_pop:
	R_MOVED
	// recuperar op2 desde prog_3
	ROT C2 R_ROT
	R_FLAG_P3_R1
	MOVED prog_3_crazy
}{
ret_op2_c1:
	R_CRAZY R_MOVED
	R_FLAG_VAL_C1_LOAD
	MOVED crazy_value_C1
}{
ret_op2_val_c1:
	R_CRAZY R_MOVED
	R_FLAG_VAL_LOAD
	MOVED crazy_value
}{
ret_op2_val:
	R_CRAZY R_MOVED
	// op2: dec1 -> carry significa op2 == 0
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
ret_op2_dec1:
	NO_MORE_CARRY_FLAG op2_nonzero
	MOVED eval_pop_op1
}{
op2_nonzero:
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
ret_op2_dec2:
	NO_MORE_CARRY_FLAG op2_is_2_or_3
	R_FLAG_OP2_IS_1
	MOVED eval_pop_op1
}{
op2_is_2_or_3:
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
ret_op2_dec3:
	NO_MORE_CARRY_FLAG op2_is_3
	R_FLAG_OP2_IS_2
	MOVED eval_pop_op1
}{
op2_is_3:
	R_FLAG_OP2_IS_3
	MOVED eval_pop_op1
}{
eval_pop_op1:
	R_MOVED
	// recuperar op1 desde prog_1
	ROT C2 R_ROT
	R_FLAG_P1_R1
	MOVED prog_1_crazy
}{
ret_eval_op1_c1:
	R_CRAZY R_MOVED
	R_FLAG_VAL_C1_LOAD
	MOVED crazy_value_C1
}{
ret_eval_op1_val_c1:
	R_CRAZY R_MOVED
	R_FLAG_VAL_LOAD
	MOVED crazy_value
}{
ret_eval_op1_val:
	R_CRAZY R_MOVED
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
ret_op1_dec1:
	NO_MORE_CARRY_FLAG op1_dec1_continue
	MOVED eval_results
}{
op1_dec1_continue:
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
ret_op1_dec2:
	NO_MORE_CARRY_FLAG op1_dec2_continue
	MOVED eval_results
}{
op1_dec2_continue:
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
ret_op1_dec3:
	NO_MORE_CARRY_FLAG op1_is_4
	MOVED eval_results
}{
op1_is_4:
	MOVED eval_results
}{
eval_results:
	// Seleccion de resultado. CMP_EQ: igualdad de clases exactas.
	CMP_MODE eval_cmp R_CMP_MODE
	FLAG_OP2_IS_1 res_is_1 R_FLAG_OP2_IS_1
	FLAG_OP2_IS_2 res_is_0 R_FLAG_OP2_IS_2
	MOVED res_is_2
}{
eval_cmp:
	// op1 == 0: igual solo si ninguna bandera de op2 activa
	FLAG_OP2_IS_1 cmp_not_equal R_FLAG_OP2_IS_1
	FLAG_OP2_IS_2 cmp_not_equal R_FLAG_OP2_IS_2
	FLAG_OP2_IS_3 cmp_not_equal R_FLAG_OP2_IS_3
	MOVED cmp_equal
}{
res_is_0:
	R_MOVED
	ROT 0 R_ROT
	MOVED eval_out
}{
res_is_1:
	R_MOVED
	ROT 3 R_ROT
	MOVED eval_out
}{
res_is_2:
	R_MOVED
	ROT 6 R_ROT
	MOVED eval_out
}{
cmp_equal:
	MOVED res_is_1
}{
cmp_not_equal:
	MOVED res_is_0
}{
eval_out:
	OUT ?- R_OUT
	HALT
}{
exit_decrement_loop:
	SUBROUTINE_FLAG1 return_from_decrement_value_1 R_SUBROUTINE_FLAG1
	SUBROUTINE_FLAG2 return_from_decrement_value_2 R_SUBROUTINE_FLAG2
	SUBROUTINE_FLAG3 ret_opcode_dec3 R_SUBROUTINE_FLAG3
	SUBROUTINE_FLAG4 ret_opcode_dec4 R_SUBROUTINE_FLAG4
	SUBROUTINE_FLAG5 ret_opcode_dec5 R_SUBROUTINE_FLAG5
}
