	ROT C2 R_ROT
	R_RESET_FLAG2
	MOVED stack_top_crazy
}{
ret_rst_st_2:
	R_CRAZY R_MOVED
	ROT C0 R_ROT
	R_RESET_FLAG3
	MOVED stack_top_crazy
}{
ret_rst_st_3:
	R_CRAZY R_MOVED
	ADD_FLAG add_rst0_done R_ADD_FLAG
	MOVED reset_and_loop
}{
pop_slot_1:
	// Pop Slot 1:
	ROT C2 R_ROT
	R_PUSH_FLAG3
	MOVED stack_top_1_crazy
}{
return_from_st1_3:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_PUSH_FLAG4
	MOVED stack_top_1_crazy
}{
return_from_st1_4:
	R_CRAZY R_MOVED
	ADD_FLAG add_pop1_done R_ADD_FLAG

	OUT ?- R_OUT

	// Reset slot 1 to C1:
	ROT C1 R_ROT
	R_RESET_FLAG1
	MOVED stack_scratch_1_crazy
}{
ret_rst_ss1_1:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_RESET_FLAG2
	MOVED stack_scratch_1_crazy
}{
ret_rst_ss1_2:
	R_CRAZY R_MOVED
	ROT C0 R_ROT
	R_RESET_FLAG3
	MOVED stack_scratch_1_crazy
}{
ret_rst_ss1_3:
	R_CRAZY R_MOVED
	ROT C1 R_ROT
	R_RESET_FLAG1
	MOVED stack_top_1_crazy
}{
ret_rst_st1_1:
	R_CRAZY R_MOVED
