/* byte_dispatch2.hell — 2-way byte-VALUE dispatch (GENERATED by vm_malbolge/tools/mbir_dispatch_gen.py).
 * Opcodes: 00 01
 * 0x00 -> HALT (no output); other listed opcodes -> marker byte; else -> echo. One-shot byte classifier, NOT the MBIR VM.
 */
.CODE
SLOT0_FLAG:
	Nop/MovD
	Jmp

SLOT1_FLAG:
	Nop/MovD
	Jmp

RESET_FLAG1:
	Nop/MovD
	Jmp

RESET_FLAG2:
	Nop/MovD
	Jmp

RESET_FLAG3:
	Nop/MovD
	Jmp

COUNTER2_1:
	MovD/Nop
	Jmp


// tmp4 will be brought to C20 if it was not C2 (EOF), otherwise it will be C21.
// to detect the value of tmp4, we will jmp (i) to its value.
// the handling is following here: depending on the result the d register will move 1 or 2 steps until execution will be continued by Jmp.

PUSH_FLAG2:
	Nop/MovD
	Jmp

PUSH_FLAG3:
	Nop/MovD
	Jmp

PUSH_FLAG4:
	Nop/MovD
	Jmp

PUSH_FLAG5:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG1:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG2:
	Nop/MovD
	Jmp

CLEAN_FLAG:
	Nop/MovD
	Jmp

ADD_FLAG:
	Nop/MovD
	Jmp

OP1_FLAG:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG4:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG5:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG6:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG3:
	Nop/MovD
	Jmp

FLAG1:
	Nop/MovD
	Jmp

FLAG2:
	Nop/MovD
	Jmp

FLAG3:
	Nop/MovD
	Jmp

FLAG4:
	Nop/MovD
	Jmp

FLAG5:
	Nop/MovD
	Jmp

FLAG6:
	Nop/MovD
	Jmp

FLAG7:
	Nop/MovD
	Jmp

FLAG8:
	Nop/MovD
	Jmp

FLAG9:
	Nop/MovD
	Jmp

LOOP2:
	Nop/MovD
	Jmp

LOOP2_2:
	Nop/MovD
	Jmp

LOOP2_3:
	Nop/MovD
	Jmp

LOOP5:
	Nop/Nop/Nop/Nop/MovD
	Jmp

NO_MORE_CARRY_FLAG:
	Nop/MovD
	Jmp

MOVED:
	MovD/Nop
	Jmp

CRAZY:
	Opr/Nop
	Jmp

ROT:
	Rot/Nop
	Jmp

HALT:
	Hlt

OUT:
	Out/Nop
	Jmp

IN:
	In/Nop
	Jmp

NOP:
	Jmp

@C21 CARRY:
	RNop
	RNop
	Jmp

.DATA
crazy_value:
	U_CRAZY value
rot_value:
	U_ROT value
value:
	C1
	FLAG2 return_from_value_2 R_FLAG2
	FLAG5 return_from_value_5 R_FLAG5
	FLAG6 return_from_value_6 R_FLAG6
	FLAG7 return_from_value_7 R_FLAG7
	FLAG8 return_from_value_8 R_FLAG8
	FLAG9 return_from_value_9 R_FLAG9
	RESET_FLAG1 ret_rst_val_1 R_RESET_FLAG1
	RESET_FLAG2 ret_rst_val_2 R_RESET_FLAG2
	RESET_FLAG3 ret_rst_val_3

crazy_value_C1:
	U_CRAZY value_C1
value_C1:
	C1
	FLAG2 return_from_value_C1_2 R_FLAG2
	FLAG5 return_from_value_C1_5 R_FLAG5
	RESET_FLAG1 ret_rst_val_c1_1 R_RESET_FLAG1
	RESET_FLAG2 ret_rst_val_c1_2 R_RESET_FLAG2
	RESET_FLAG3 ret_rst_val_c1_3


crazy_tmp:
	U_CRAZY tmp
tmp:
	C0
	FLAG1 return_from_tmp_1 R_FLAG1
	FLAG2 return_from_tmp_2 R_FLAG2
	FLAG3 return_from_tmp_3 R_FLAG3
	FLAG4 return_from_tmp_4

crazy_carry:
	U_CRAZY carry
exec_carry:
	R_MOVED
carry:
	CARRY
	U_NOP execution_not_jumped_to_carry
	U_NOP carry_was_not_set U_NOP carry_was_set
carry_was_set:
	MOVED return_carry_was_set
carry_was_not_set:
	MOVED return_carry_was_not_set
execution_not_jumped_to_carry:
	FLAG1 return_from_carry_1 R_FLAG1
	FLAG2 return_from_carry_2 R_FLAG2
	FLAG3 return_from_carry_reset R_FLAG3
return_carry_was_set:
	FLAG1 return_from_carry_was_set_1 R_FLAG1
	FLAG2 return_from_carry_was_set_2 R_FLAG2
return_carry_was_not_set:
	FLAG1 return_from_carry_was_not_set_1 R_FLAG1
	FLAG2 return_from_carry_was_not_set_2
// +-----------------------------------------+ \\
// | DECLARATION/INITIALIZATION OF VARIABLES | \\
// +-----------------------------------------+ \\
//
// variables (tmp1, tmp2, tmp3 and tmp4), their functions to modify them,
// and checking FLAGn for return selection.
stack_scratch_crazy:
	U_CRAZY stack_scratch
stack_scratch:
	C1
	PUSH_FLAG5 return_from_stack_scratch_2 R_PUSH_FLAG5
	RESET_FLAG1 ret_rst_ss_1 R_RESET_FLAG1
	RESET_FLAG2 ret_rst_ss_2 R_RESET_FLAG2
	RESET_FLAG3 ret_rst_ss_3


stack_scratch_1_crazy:
	U_CRAZY stack_scratch_1
stack_scratch_1:
	C1
	PUSH_FLAG5 return_from_ss1_2 R_PUSH_FLAG5
	RESET_FLAG1 ret_rst_ss1_1 R_RESET_FLAG1
	RESET_FLAG2 ret_rst_ss1_2 R_RESET_FLAG2
	RESET_FLAG3 ret_rst_ss1_3

stack_top_1_crazy:
	U_CRAZY stack_top_1
stack_top_1:
	C1
	PUSH_FLAG2 return_from_st1_2 R_PUSH_FLAG2
	PUSH_FLAG3 return_from_st1_3 R_PUSH_FLAG3
	PUSH_FLAG4 return_from_st1_4 R_PUSH_FLAG4
	RESET_FLAG1 ret_rst_st1_1 R_RESET_FLAG1
	RESET_FLAG2 ret_rst_st1_2 R_RESET_FLAG2
	RESET_FLAG3 ret_rst_st1_3

stack_top_crazy:
	U_CRAZY stack_top
stack_top:
	C1
	PUSH_FLAG2 return_from_stack_top_2 R_PUSH_FLAG2
	PUSH_FLAG3 return_from_stack_top_3 R_PUSH_FLAG3
	PUSH_FLAG4 return_from_stack_top_4 R_PUSH_FLAG4
	RESET_FLAG1 ret_rst_st_1 R_RESET_FLAG1
	RESET_FLAG2 ret_rst_st_2 R_RESET_FLAG2
	RESET_FLAG3 ret_rst_st_3

{
ENTRY:
	MOVED next_opcode
}{
next_opcode:
	R_MOVED
	IN ?- R_IN
	R_FLAG2
	MOVED crazy_value_C1
}{
return_from_value_C1_2:
	R_CRAZY R_MOVED
	R_FLAG2
	MOVED crazy_value
}{
return_from_value_2:
	R_CRAZY R_MOVED
	// EOF test: inc overflows IFF B=C2.
	R_SUBROUTINE_FLAG1
	MOVED increment_value
}{
return_from_increment_value_1:
	NO_MORE_CARRY_FLAG got_byte
	MOVED got_eof
}{
got_eof:
	HALT
}{
got_byte:
	// value=B+1. dec(site1) -> B.
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
return_from_decrement_value_1:
	// value=B.
	// dec(site2): value=B-1 (overflow IFF B==0x00).
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
return_from_decrement_value_2:
	NO_MORE_CARRY_FLAG disc_1
	MOVED dispatch_00
}{
disc_1:
	// dec(site3): value=B-2 (overflow IFF B==0x01).
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
return_from_decrement_value_3:
	NO_MORE_CARRY_FLAG disc_2
	MOVED dispatch_01
}{
disc_2:
	R_SUBROUTINE_FLAG4
	MOVED decrement_value
}{
return_from_decrement_value_4:
	OP1_FLAG return_from_dec_op1_3 R_OP1_FLAG
	NO_MORE_CARRY_FLAG dispatch_fallback
	MOVED dispatch_02
}{
dispatch_00:
	HALT
}{
dispatch_01:
	IN ?- R_IN
	R_MOVED
	SLOT0_FLAG push_slot_1
	// Slot 0 (depth 0 -> 1):
	R_PUSH_FLAG5
	MOVED stack_scratch_crazy
}{
return_from_stack_scratch_2:
	R_CRAZY R_MOVED
	R_PUSH_FLAG2
	MOVED stack_top_crazy
}{
return_from_stack_top_2:
	R_CRAZY R_MOVED
	ADD_FLAG add_push0_done R_ADD_FLAG
	MOVED reset_and_loop
}{
push_slot_1:
	// Slot 1 (depth 1 -> 2):
	R_SLOT0_FLAG
	R_SLOT1_FLAG
	R_PUSH_FLAG5
	MOVED stack_scratch_1_crazy
}{
return_from_ss1_2:
	R_CRAZY R_MOVED
	R_PUSH_FLAG2
	MOVED stack_top_1_crazy
}{
return_from_st1_2:
	R_CRAZY R_MOVED
	MOVED reset_and_loop
}{
dispatch_02:
	R_MOVED
	R_CLEAN_FLAG
	MOVED reset_and_loop
}{
add_val_clean:
	OP1_FLAG add_val_clean_op1 R_OP1_FLAG
	R_ADD_FLAG
	ROT C2 R_ROT
	R_PUSH_FLAG3
	MOVED stack_top_1_crazy
}{
add_pop1_done:
	R_FLAG5
	MOVED crazy_value_C1
}{
return_from_value_C1_5:
	R_CRAZY R_MOVED
	R_FLAG5
	MOVED crazy_value
}{
return_from_value_5:
	R_CRAZY R_MOVED
	OP1_FLAG dec_op1 R_OP1_FLAG
	R_SUBROUTINE_FLAG5
	MOVED decrement_value
}{
return_from_dec_op2_1:
	OP1_FLAG return_from_dec_op1_1 R_OP1_FLAG
	NO_MORE_CARRY_FLAG op2_nonzero
	MOVED diff_is_2
}{
op2_nonzero:
	R_SUBROUTINE_FLAG6
	MOVED decrement_value
}{
return_from_dec_op2_2:
	OP1_FLAG return_from_dec_op1_2 R_OP1_FLAG
	NO_MORE_CARRY_FLAG op2_is_2
	MOVED diff_is_1
}{
op2_is_2:
	R_OP1_FLAG
	R_CLEAN_FLAG
	MOVED reset_and_loop
}{
add_val_clean_op1:
	R_OP1_FLAG
	R_ADD_FLAG
	ROT C2 R_ROT
	R_PUSH_FLAG3
	MOVED stack_top_crazy
}{
add_pop0_done:
	R_FLAG5
	MOVED crazy_value_C1
}{
dec_op1:
	R_OP1_FLAG
	R_SUBROUTINE_FLAG5
	MOVED decrement_value
}{
return_from_dec_op1_1:
	R_OP1_FLAG
	R_SUBROUTINE_FLAG6
	MOVED decrement_value
}{
return_from_dec_op1_2:
	R_OP1_FLAG
	R_SUBROUTINE_FLAG4
	MOVED decrement_value
}{
return_from_dec_op1_3:
	NO_MORE_CARRY_FLAG diff_is_2_from_phase2
	MOVED diff_is_0
}{
diff_is_2_from_phase2:
	MOVED diff_is_2
}{
diff_is_0:
	R_MOVED
	R_OP1_FLAG
	R_SUBROUTINE_FLAG4
	MOVED diff_is_2
}{
diff_is_1:
	R_MOVED
	R_OP1_FLAG
	MOVED diff_is_2
}{
diff_is_2:
	R_MOVED
	R_ADD_FLAG
	ROT C1 R_ROT
	R_RESET_FLAG1
	MOVED stack_scratch_crazy
}{
add_rst0_done:
	OP1_FLAG check_diff_1_or_0 R_OP1_FLAG
	ROT 6 R_ROT
	MOVED add_push_common
}{
check_diff_1_or_0:
	SUBROUTINE_FLAG4 load_diff_0 R_SUBROUTINE_FLAG4
	ROT 3 R_ROT
	MOVED add_push_common
}{
load_diff_0:
	ROT 0 R_ROT
	MOVED add_push_common
}{
add_push_common:
	R_MOVED
	R_ADD_FLAG
	R_PUSH_FLAG5
	MOVED stack_scratch_crazy
}{
add_push0_done:
	R_SLOT1_FLAG
	ROT C1 R_ROT
	R_RESET_FLAG1
	MOVED stack_scratch_1_crazy
}{

dispatch_fallback:
	SLOT1_FLAG pop_slot_1
	// Fall-through: Slot 1 empty, pop Slot 0
	R_SLOT1_FLAG
	R_SLOT0_FLAG
	ROT C2 R_ROT
	R_PUSH_FLAG3
	MOVED stack_top_crazy
}{
return_from_stack_top_3:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_PUSH_FLAG4
	MOVED stack_top_crazy
}{
return_from_stack_top_4:
	R_CRAZY R_MOVED
	ADD_FLAG add_pop0_done R_ADD_FLAG

	OUT ?- R_OUT

	// Reset slot 0 to C1:
	ROT C1 R_ROT
	R_RESET_FLAG1
	MOVED stack_scratch_crazy
}{
ret_rst_ss_1:
	R_CRAZY R_MOVED
	ROT C2 R_ROT
	R_RESET_FLAG2
	MOVED stack_scratch_crazy
}{
ret_rst_ss_2:
	R_CRAZY R_MOVED
	ROT C0 R_ROT
	R_RESET_FLAG3
	MOVED stack_scratch_crazy
}{
ret_rst_ss_3:
	R_CRAZY R_MOVED
	ROT C1 R_ROT
	R_RESET_FLAG1
	MOVED stack_top_crazy
}{
ret_rst_st_1:
