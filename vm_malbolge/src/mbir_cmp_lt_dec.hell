/* cmp_lt_dec.hell — CMP_LT decimal, disenado desde el principio para la
 * tecnica de parejas de ciclos xlat2 acoplados (5 y 2).
 * Generado por vm_malbolge/tools/cmp_lt_dec_gen.py.
 *
 * Entrada: dos digitos decimales separados por cualquier no-digito.
 * Salida:  '1' si A < B, '0' en caso contrario.
 */
.CODE
MOVED:
	MovD/Nop
	Jmp

ROT:
	Rot/Nop
	Jmp

CRAZY:
	Opr/Nop
	Jmp

HALT:
	Hlt

OUT:
	Out/Nop
	Jmp

IN:
	In/Nop
	Jmp

NOP:
	Jmp

@C21 CARRY:
	RNop
	RNop
	Jmp

// parejas de ciclos: HIGH ciclo 5, LOW ciclo 2 (una bandera cualquiera)
// El diseño usa LOOP5 (ciclo de 5) y FLAG1 (ciclo de 2) como la pareja.
LOOP5:
	Nop/Nop/Nop/Nop/MovD
	Jmp

NO_MORE_CARRY_FLAG:
	Nop/MovD
	Jmp

FLAG1:
	Nop/MovD
	Jmp

FLAG2:
	Nop/MovD
	Jmp

FLAG3:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG1:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG2:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG3:
	Nop/MovD
	Jmp

PHASE_A:
	Nop/MovD
	Jmp

FLAG_READ_A_C1:
	Nop/MovD
	Jmp

FLAG_READ_A:
	Nop/MovD
	Jmp

FLAG_READ_B_C1:
	Nop/MovD
	Jmp

FLAG_READ_B:
	Nop/MovD
	Jmp

PHASE_B:
	Nop/MovD
	Jmp

FLAG_A_IS_0:
	Nop/MovD
	Jmp

FLAG_A_IS_1:
	Nop/MovD
	Jmp

FLAG_A_IS_2:
	Nop/MovD
	Jmp

FLAG_A_IS_GE3:
	Nop/MovD
	Jmp

FLAG_SS_PUSH:
	Nop/MovD
	Jmp

FLAG_ST_PUSH:
	Nop/MovD
	Jmp

FLAG_ST_POP:
	Nop/MovD
	Jmp

FLAG_D2_TMP3:
	Nop/MovD
	Jmp

FLAG_D2_TMP4:
	Nop/MovD
	Jmp

FLAG_D2_VAL8:
	Nop/MovD
	Jmp

FLAG_D2_VAL9:
	Nop/MovD
	Jmp

FLAG_D2_READ:
	Nop/MovD
	Jmp

FLAG_D2_CARRY2:
	Nop/MovD
	Jmp

SUBROUTINE2_FLAG1:
	Nop/MovD
	Jmp

LOOP2:
	Nop/Nop/Nop/MovD
	Jmp

LOOP2_2:
	Nop/Nop/Nop/MovD
	Jmp

LOOP2_3:
	Nop/Nop/Nop/MovD
	Jmp

.DATA
crazy_value:
	U_CRAZY value
rot_value:
	U_ROT value
value:
	C1
	FLAG_READ_A ret_st_push R_FLAG_READ_A
	FLAG1 return_from_value_3 R_FLAG1

crazy_value_C1:
	U_CRAZY value_C1
value_C1:
	C1
	FLAG_READ_A_C1 return_from_value_C1_1 R_FLAG_READ_A_C1

crazy_ss:
	U_CRAZY stack_scratch
stack_scratch:
	C1
	FLAG_SS_PUSH ret_ss_push R_FLAG_SS_PUSH

crazy_st:
	U_CRAZY stack_top
stack_top:
	C1
	FLAG_ST_PUSH ret_st_push R_FLAG_ST_PUSH

crazy_value2_C1:
	U_CRAZY value2_C1
value2_C1:
	C1
	FLAG_D2_READ return_from_value2_C1_1 R_FLAG_D2_READ

crazy_value2:
	U_CRAZY value2
rot_value2:
	U_ROT value2
value2:
	C1
	FLAG_D2_READ compare R_FLAG_D2_READ
	FLAG_D2_VAL8 return_from_value2_8 R_FLAG_D2_VAL8
	FLAG_D2_VAL9 return_from_value2_9

crazy_tmp2:
	U_CRAZY tmp2
tmp2:
	C0
	FLAG_D2_TMP3 return_from_tmp2_3 R_FLAG_D2_TMP3
	FLAG_D2_TMP4 return_from_tmp2_4

crazy_carry2:
	U_CRAZY carry2
exec_carry2:
	R_MOVED
carry2:
	CARRY
	U_NOP execution_not_jumped_to_carry2
	U_NOP carry2_was_not_set U_NOP carry2_was_set
carry2_was_set:
	MOVED return_carry2_was_set
carry2_was_not_set:
	MOVED return_carry2_was_not_set
execution_not_jumped_to_carry2:
	FLAG_D2_CARRY2 return_from_carry2_2 R_FLAG_D2_CARRY2
return_carry2_was_set:
	FLAG_D2_CARRY2 return_from_carry2_was_set_1 R_FLAG_D2_CARRY2
return_carry2_was_not_set:
	FLAG_D2_CARRY2 return_from_carry2_was_not_set_1 R_FLAG_D2_CARRY2

crazy_tmp:
	U_CRAZY tmp
tmp:
	C0
	FLAG1 return_from_tmp_1 R_FLAG1

crazy_carry:
	U_CRAZY carry
exec_carry:
	R_MOVED
carry:
	CARRY
	U_NOP execution_not_jumped_to_carry
	U_NOP carry_was_not_set U_NOP carry_was_set
carry_was_set:
	MOVED return_carry_was_set
carry_was_not_set:
	MOVED return_carry_was_not_set
execution_not_jumped_to_carry:
	FLAG1 return_from_carry_1 R_FLAG1
return_carry_was_set:
	FLAG1 return_from_carry_was_set_1 R_FLAG1
return_carry_was_not_set:
	FLAG1 return_from_carry_was_not_set_1 R_FLAG1

// Mecanismo de entrada documentado: D apunta aqui, C a un Jmp.
ENTRY:
	read_digit_A

{
read_digit_A:
	// Leer un digito: copiarlo a value_C1 y luego a value.
	R_MOVED
	IN ?- R_IN
	R_FLAG_READ_A_C1
	MOVED crazy_value_C1
}{
return_from_value_C1_1:
	R_CRAZY R_MOVED
	R_FLAG_READ_A
	MOVED crazy_value
}{
ret_push_ss:
	R_CRAZY R_MOVED
	R_FLAG_ST_PUSH
	MOVED crazy_st
}{
ret_ss_push:
	R_CRAZY R_MOVED
	R_FLAG_ST_PUSH
	MOVED crazy_st
}{
ret_st_push:
	R_CRAZY R_MOVED
	// A vive en value (no se clasifica: la clasificacion lo destruiría).
	// Ir directo a leer B, que aterrizará en value2.
	MOVED read_digit_B
}{
ret_A_d1:
	NO_MORE_CARRY_FLAG A_ge_1
	// carry en dec1 => A == 0
	R_FLAG_A_IS_0
	MOVED A_class_done
}{
A_ge_1:
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
ret_A_d2:
	NO_MORE_CARRY_FLAG A_ge_2
	// carry en dec2 => A == 1
	R_FLAG_A_IS_1
	MOVED A_class_done
}{
A_ge_2:
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
ret_A_d3:
	NO_MORE_CARRY_FLAG A_ge_3
	// carry en dec3 => A == 2
	R_FLAG_A_IS_2
	MOVED A_class_done
}{
A_ge_3:
	// sin carry tras dec3 => A >= 3
	R_FLAG_A_IS_GE3
	MOVED A_class_done
}{
A_class_done:
	R_PHASE_A
	MOVED read_digit_B
}{
read_digit_B:
	R_MOVED
	IN ?- R_IN
	R_FLAG_D2_READ
	MOVED crazy_value2_C1
}{
return_from_value2_C1_1:
	R_CRAZY R_MOVED
	R_FLAG_D2_READ
	MOVED crazy_value2
}{
return_from_value_2:
	R_CRAZY R_MOVED
	R_PHASE_B
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
ret_B_d1:
	NO_MORE_CARRY_FLAG B_ge_1
	MOVED B_class_done
}{
B_ge_1:
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
ret_B_d2:
	NO_MORE_CARRY_FLAG B_ge_2
	MOVED B_class_done
}{
B_ge_2:
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
ret_B_d3:
	MOVED B_class_done
}{
B_class_done:
	R_PHASE_B
	MOVED compare
}{
compare:
	// A vive en value, B vive en value2. Alternar decrementos.
	R_MOVED
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
ret_dec_B:
	NO_MORE_CARRY_FLAG B_still
	// B llegó a cero antes que A  =>  A >= B  =>  falso
	MOVED result_false
}{
B_still:
	R_SUBROUTINE2_FLAG1
	MOVED decrement_value2
}{
ret_dec_A:
	NO_MORE_CARRY_FLAG A_still
	// A llegó a cero antes que B  =>  A < B  =>  verdadero
	MOVED result_true
}{
A_still:
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
result_true:
	R_MOVED
	ROT 3 R_ROT
	MOVED print
}{
result_false:
	R_MOVED
	ROT 0 R_ROT
	MOVED print
}{
print:
	OUT ?- R_OUT
	HALT
}

// ==========================================
// SEGUNDA SUBRUTINA DE DECREMENTO (ligada a value2): bloque autonomo
// ==========================================
{
decrement_value2:
	NO_MORE_CARRY_FLAG nomorecarrykilled_d2 R_NO_MORE_CARRY_FLAG
nomorecarrykilled_d2:
	R_MOVED
	ROT C1 R_ROT
	R_FLAG_D2_TMP3
	MOVED crazy_tmp2

return_from_tmp2_3:
	R_CRAZY
value2_load_loop:
	ROT C2 R_ROT
jmp_into_loop_from_behind_d2:
	R_MOVED
	R_FLAG_D2_VAL8
	MOVED crazy_value2

return_from_value2_8:
	R_CRAZY R_MOVED
	LOOP2 value2_loaded
	MOVED value2_load_loop

value2_loaded:
	LOOP2_2 jump_back_to_behind_d2
	R_FLAG_D2_TMP4
	MOVED crazy_tmp2

return_from_tmp2_4:
	R_CRAZY R_MOVED
	R_FLAG_D2_CARRY2
	MOVED crazy_carry2

return_from_carry2_2:
	R_CRAZY R_MOVED
	MOVED jmp_into_loop_from_behind_d2

jump_back_to_behind_d2:
	R_FLAG_D2_CARRY2
	MOVED exec_carry2

return_from_carry2_was_not_set_1:
	R_NO_MORE_CARRY_FLAG
return_from_carry2_was_set_1:
	R_MOVED
	R_FLAG_D2_VAL9
	MOVED rot_value2

return_from_value2_9:
	R_MOVED R_ROT
	LOOP5 exit_inner_decrement_loop_d2
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_d2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value2

exit_inner_decrement_loop_d2:
	LOOP2_3 exit_decrement_loop_d2
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_d2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value2

restore_no_more_carry_flag_and_rotate_value_d2:
	R_NO_MORE_CARRY_FLAG
	MOVED return_from_carry2_was_set_1

exit_decrement_loop_d2:
	SUBROUTINE2_FLAG1 ret_dec_A R_SUBROUTINE2_FLAG1
}
{
decrement_value:
	NO_MORE_CARRY_FLAG nomorecarrykilled_2 R_NO_MORE_CARRY_FLAG
nomorecarrykilled_2:
	R_MOVED
	ROT C1 R_ROT
	R_FLAG1
	MOVED crazy_tmp

return_from_tmp_1:
	R_CRAZY
value_load_loop:
	ROT C2 R_ROT
jmp_into_loop_from_behind:
	R_MOVED
	R_FLAG1
	MOVED crazy_value

return_from_value_3:
	R_CRAZY R_MOVED
	LOOP2 value_loaded
	MOVED value_load_loop

value_loaded:
	LOOP2_2 jump_back_to_behind
	R_FLAG1
	MOVED crazy_tmp

return_from_tmp_2:
	R_CRAZY R_MOVED
	R_FLAG1
	MOVED crazy_carry

return_from_carry_1:
	R_CRAZY R_MOVED
	MOVED jmp_into_loop_from_behind

jump_back_to_behind:
	R_FLAG1
	MOVED exec_carry

return_from_carry_was_not_set_1:
	R_NO_MORE_CARRY_FLAG
return_from_carry_was_set_1:
	R_MOVED
	R_FLAG1
	MOVED rot_value

return_from_value_4:
	R_MOVED R_ROT
	LOOP5 exit_inner_decrement_loop
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value

exit_inner_decrement_loop:
	LOOP2_3 exit_decrement_loop
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value

restore_no_more_carry_flag_and_rotate_value_2:
	R_NO_MORE_CARRY_FLAG
	MOVED return_from_carry_was_set_1

exit_decrement_loop:
	// Compuerta de fase SIN R_: no consume la bandera, para que enrute todos
	// los retornos de la fase. Se limpia solo en el bloque terminal de la fase.
	PHASE_A exit_phase_A
	PHASE_B exit_phase_B
	SUBROUTINE_FLAG1 ret_dec_B R_SUBROUTINE_FLAG1
	SUBROUTINE_FLAG2 ret_dec_B R_SUBROUTINE_FLAG2
	SUBROUTINE_FLAG3 ret_dec_B R_SUBROUTINE_FLAG3
}{
exit_phase_A:
	SUBROUTINE_FLAG1 ret_A_d1 R_SUBROUTINE_FLAG1
	SUBROUTINE_FLAG2 ret_A_d2 R_SUBROUTINE_FLAG2
	SUBROUTINE_FLAG3 ret_A_d3 R_SUBROUTINE_FLAG3
}{
exit_phase_B:
	SUBROUTINE_FLAG1 ret_B_d1 R_SUBROUTINE_FLAG1
	SUBROUTINE_FLAG2 ret_B_d2 R_SUBROUTINE_FLAG2
	SUBROUTINE_FLAG3 ret_B_d3 R_SUBROUTINE_FLAG3
}
