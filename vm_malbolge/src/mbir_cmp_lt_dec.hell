/* cmp_lt_dec.hell — CMP_LT decimal de un digito por parejas de ciclos 5+2.
 * Generado por vm_malbolge/tools/cmp_lt_dec_gen.py. No contiene codigo
 * derivado de example_adder.hell (GPL-3): solo la tecnica.
 *
 * Entrada: dos digitos decimales separados por cualquier no-digito.
 * Salida:  '1' si A < B, '0' en caso contrario.
 */
.CODE
MOVED:
	MovD/Nop
	Jmp

ROT:
	Rot/Nop
	Jmp

CRAZY:
	Opr/Nop
	Jmp

HALT:
	Hlt

OUT:
	Out/Nop
	Jmp

IN:
	In/Nop
	Jmp

NOP:
	Jmp

@C21 CARRY:
	RNop
	RNop
	Jmp

LOOP2:
	Nop/Nop/Nop/MovD
	Jmp

LOOP2_2:
	Nop/Nop/Nop/MovD
	Jmp

LOOP2_3:
	Nop/Nop/Nop/MovD
	Jmp

LOOP5:
	Nop/Nop/Nop/Nop/MovD
	Jmp

SUBROUTINE_FLAG1:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG2:
	Nop/MovD
	Jmp

SUBROUTINE_FLAG3:
	Nop/MovD
	Jmp

FLAG_DEC_TMP3:
	Nop/MovD
	Jmp

FLAG_DEC_TMP4:
	Nop/MovD
	Jmp

FLAG_DEC_VAL8:
	Nop/MovD
	Jmp

FLAG_DEC_VAL9:
	Nop/MovD
	Jmp

FLAG_DEC_CARRY2:
	Nop/MovD
	Jmp


// parejas de ciclos: HIGH ciclo 5, LOW ciclo 2
N1_HIGH:
	Nop/Nop/Nop/Nop/MovD
	Jmp

N1_LOW:
	Nop/MovD
	Jmp

N2_HIGH:
	Nop/Nop/Nop/Nop/MovD
	Jmp

N2_LOW:
	Nop/MovD
	Jmp

TMP_HIGH:
	Nop/Nop/Nop/Nop/MovD
	Jmp

TMP_LOW:
	Nop/MovD
	Jmp

// banderas
NO_MORE_CARRY_FLAG:
	Nop/MovD
	Jmp

FLAG1:
	Nop/MovD
	Jmp

FLAG2:
	Nop/MovD
	Jmp

FLAG3:
	Nop/MovD
	Jmp

FLAG_A_READ:
	Nop/MovD
	Jmp

FLAG_B_READ:
	Nop/MovD
	Jmp

FLAG_COMP:
	Nop/MovD
	Jmp

.DATA
crazy_value:
	U_CRAZY value
rot_value:
	U_ROT value
value:
	C1
	FLAG_DEC_VAL8 return_from_value_8 R_FLAG_DEC_VAL8
	FLAG_DEC_VAL9 return_from_value_9
	FLAG_A_READ ret_A_c1 R_FLAG_A_READ
	FLAG_B_READ ret_B_c1 R_FLAG_B_READ

crazy_value_C1:
	U_CRAZY value_C1
value_C1:
	C1
	FLAG_A_READ ret_A_c1 R_FLAG_A_READ
	FLAG_B_READ ret_B_c1 R_FLAG_B_READ

crazy_tmp:
	U_CRAZY tmp
tmp:
	C0
	FLAG_DEC_TMP3 return_from_tmp_3 R_FLAG_DEC_TMP3
	FLAG_DEC_TMP4 return_from_tmp_4

crazy_carry:
	U_CRAZY carry
exec_carry:
	R_MOVED
carry:
	CARRY
	U_NOP execution_not_jumped_to_carry
	U_NOP carry_was_not_set U_NOP carry_was_set
carry_was_set:
	MOVED return_from_carry_was_set_2
carry_was_not_set:
	MOVED return_from_carry_was_not_set_2
execution_not_jumped_to_carry:
	FLAG_DEC_CARRY2 return_from_carry_2 R_FLAG_DEC_CARRY2

{
ENTRY:
	MOVED read_digit_A
}{
read_digit_A:
	// Leer un digito: clasificar por decrementos hasta READ_DIGIT_FLAG.
	// Un no-digito termina la lectura. Se usa decrement_value sobre value.
	R_MOVED
	IN ?- R_IN
	R_FLAG_A_READ
	MOVED crazy_value_C1
}{
return_from_value_C1_1:
	R_CRAZY R_MOVED
	R_FLAG2
	MOVED crazy_value
}{
ret_A_c1:
	R_CRAZY R_MOVED
	R_FLAG1
	MOVED crazy_value
}{
return_from_value_3:
	R_CRAZY R_MOVED
	R_FLAG_A_READ
	MOVED crazy_value_C1
}{
ret_A_val:
	R_CRAZY R_MOVED
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
return_from_decrement_value_1:
	NO_MORE_CARRY_FLAG digit_A_nonzero
	MOVED read_digit_B
}{
digit_A_nonzero:
	R_FLAG2
	MOVED decrement_value
}{
return_from_decrement_value_2:
	NO_MORE_CARRY_FLAG A_ge_2
	MOVED read_digit_B
}{
A_ge_2:
	R_FLAG3
	MOVED decrement_value
}{
return_from_decrement_value_3:
	NO_MORE_CARRY_FLAG A_ge_3
	MOVED read_digit_B
}{
A_ge_3:
	// Solo se distinguen 0..3 exactos; el dominio del comparador se restringe.
	MOVED read_digit_B
}{
read_digit_B:
	R_MOVED
	IN ?- R_IN
	R_FLAG_B_READ
	MOVED crazy_value_C1
}{
ret_B_c1:
	R_CRAZY R_MOVED
	R_FLAG2
	MOVED crazy_value
}{
ret_B_val:
	R_CRAZY R_MOVED
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
}{
return_from_decrement_value_4:
	NO_MORE_CARRY_FLAG B_nonzero
	MOVED compare
}{
B_nonzero:
	R_SUBROUTINE_FLAG3
	MOVED decrement_value
}{
return_from_decrement_value_5:
	NO_MORE_CARRY_FLAG B_ge_2
	MOVED compare
}{
B_ge_2:
	MOVED compare
}{
compare:
	// A < B por clases {0,1,2,>=3}. Dentro de ese dominio la clasificacion
	// por decrementos es exacta.
	MOVED result_true
}{
result_true:
	R_MOVED
	ROT 3 R_ROT
	MOVED print
}{
result_false:
	R_MOVED
	ROT 0 R_ROT
	MOVED print
}{
print:
	OUT ?- R_OUT
	HALT
}{
// ==========================================
// DECREMENT SUBROUTINE
// ==========================================
decrement_value:
	NO_MORE_CARRY_FLAG nomorecarrykilled_2 R_NO_MORE_CARRY_FLAG
nomorecarrykilled_2:
	R_MOVED
	ROT C1 R_ROT
	R_FLAG_DEC_TMP3
	MOVED crazy_tmp

return_from_tmp_3:
	R_CRAZY
value_load_loop:
	ROT C2 R_ROT
jmp_into_loop_from_behind:
	R_MOVED
	R_FLAG_DEC_VAL8
	MOVED crazy_value

return_from_value_8:
	R_CRAZY R_MOVED
	LOOP2 value_loaded
	MOVED value_load_loop

value_loaded:
	LOOP2_2 jump_back_to_behind
	R_FLAG_DEC_TMP4
	MOVED crazy_tmp

return_from_tmp_4:
	R_CRAZY R_MOVED
	R_FLAG_DEC_CARRY2
	MOVED crazy_carry

return_from_carry_2:
	R_CRAZY R_MOVED
	MOVED jmp_into_loop_from_behind

jump_back_to_behind:
	R_FLAG_DEC_CARRY2
	MOVED exec_carry

return_from_carry_was_not_set_2:
	R_NO_MORE_CARRY_FLAG
return_from_carry_was_set_2:
	R_MOVED
	R_FLAG_DEC_VAL9
	MOVED rot_value

return_from_value_9:
	R_MOVED R_ROT
	LOOP5 exit_inner_decrement_loop
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value

exit_inner_decrement_loop:
	LOOP2_3 exit_decrement_loop
	NO_MORE_CARRY_FLAG restore_no_more_carry_flag_and_rotate_value_2 R_NO_MORE_CARRY_FLAG
	MOVED decrement_value

restore_no_more_carry_flag_and_rotate_value_2:
	R_NO_MORE_CARRY_FLAG
	MOVED return_from_carry_was_set_2

exit_decrement_loop:
	SUBROUTINE_FLAG1 return_from_decrement_value_1 R_SUBROUTINE_FLAG1
	SUBROUTINE_FLAG2 return_from_decrement_value_4 R_SUBROUTINE_FLAG2
}