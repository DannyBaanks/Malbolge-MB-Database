scratch_8:
	C1
	FLAG_SCR ret_scr_8 R_FLAG_SCR


prog_0_crazy:
	U_CRAZY prog_0
prog_0:
	C1
	FLAG_STORE ret_p0 R_FLAG_STORE
	FLAG_READ_A ret_p0_a R_FLAG_READ_A
	FLAG_READ_B ret_p0_b R_FLAG_READ_B
prog_1_crazy:
	U_CRAZY prog_1
prog_1:
	C1
	FLAG_STORE ret_p1 R_FLAG_STORE
	FLAG_READ_A ret_p1_a R_FLAG_READ_A
	FLAG_READ_B ret_p1_b R_FLAG_READ_B
prog_4_crazy:
	U_CRAZY prog_4
prog_4:
	C1
	FLAG_STORE ret_p4 R_FLAG_STORE
	FLAG_READ_A ret_p4_a R_FLAG_READ_A
	FLAG_READ_B ret_p4_b R_FLAG_READ_B
prog_6_crazy:
	U_CRAZY prog_6
prog_6:
	C1
	FLAG_STORE ret_p6 R_FLAG_STORE
	FLAG_READ_A ret_p6_a R_FLAG_READ_A
	FLAG_READ_B ret_p6_b R_FLAG_READ_B
prog_7_crazy:
	U_CRAZY prog_7
prog_7:
	C1
	FLAG_STORE ret_p7 R_FLAG_STORE
	FLAG_READ_A ret_p7_a R_FLAG_READ_A
	FLAG_READ_B ret_p7_b R_FLAG_READ_B
prog_8_crazy:
	U_CRAZY prog_8
prog_8:
	C1
	FLAG_STORE ret_p8 R_FLAG_STORE
	FLAG_READ_A ret_p8_a R_FLAG_READ_A
	FLAG_READ_B ret_p8_b R_FLAG_READ_B

{
ENTRY:
	IN ?- R_IN
	R_FLAG_SCR
	MOVED scratch_0_crazy
}{
ret_scr_0:
	R_CRAZY R_MOVED
	R_FLAG_STORE
	MOVED prog_0_crazy
}{
ret_p0:
	R_CRAZY R_MOVED
	IN ?- R_IN
	R_FLAG_SCR
	MOVED scratch_1_crazy
}{
ret_scr_1:
	R_CRAZY R_MOVED
	R_FLAG_STORE
	MOVED prog_1_crazy
}{
ret_p1:
