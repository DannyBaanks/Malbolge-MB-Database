	R_CRAZY R_MOVED
	R_FLAG_STORE
	MOVED prog_4_crazy
}{
ret_p4:
	R_CRAZY R_MOVED
	IN ?- R_IN
	IN ?- R_IN
	R_FLAG_SCR
	MOVED scratch_6_crazy
}{
ret_scr_6:
	R_CRAZY R_MOVED
	R_FLAG_STORE
	MOVED prog_6_crazy
}{
ret_p6:
