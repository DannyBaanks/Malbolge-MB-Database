	IN ?- R_IN
	R_FLAG2
	MOVED crazy_value_C1
}{
return_from_value_C1_2:
	R_CRAZY R_MOVED
	R_FLAG2
	MOVED crazy_value
}{
return_from_value_2:
	R_CRAZY R_MOVED
	// save value(=B)->save_B via save_tmp. A ends = B.
	R_FLAG10
	MOVED crazy_save_tmp
}{
return_from_save_tmp_10:
	R_CRAZY R_MOVED
	R_FLAG10
	MOVED crazy_save_B
}{
return_from_save_B_10:
	R_CRAZY R_MOVED
	// EOF test: inc overflows IFF B=C2.
	R_SUBROUTINE_FLAG1
	MOVED increment_value
}{
return_from_increment_value_1:
	NO_MORE_CARRY_FLAG got_byte
	MOVED got_eof
}{
got_eof:
	HALT
}{
got_byte:
	// value=B+1. dec(site1) -> B.
	R_SUBROUTINE_FLAG1
	MOVED decrement_value
}{
return_from_decrement_value_1:
	// value=B.
	// dec(site2): value=B-1 (overflow IFF B==0x00).
	R_SUBROUTINE_FLAG2
	MOVED decrement_value
