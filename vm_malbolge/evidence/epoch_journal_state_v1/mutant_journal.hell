/* byte_dispatch18.hell — 18-way byte-VALUE dispatch (GENERATED by vm_malbolge/tools/mbir_dispatch_gen.py).
 * Opcodes: 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 10 11
 * 0x00 -> HALT (no output); other listed opcodes -> marker byte; else -> echo. One-shot byte classifier, NOT the MBIR VM.
 */
.CODE
J_SAVE:
