  "claims": [
    {
      "claim": "The image reproduces the reference semantics of ADD, SUB only on a bounded operand subset.",
      "status": "DEMONSTRATED",
      "evidence": "grid over {0..4}^2: ADD 5/25 (outcomes ['02', '05', '07']); SUB 4/25 (outcomes ['00', '01', '02']); 36 measured cases diverge from the reference."
    },
    {
      "claim": "The two engines agree bit-exactly on every measured case, so the divergence is a property of the program, not of the runner.",
      "status": "DEMONSTRATED",
      "evidence": "0 engine divergences across 72 cases."
    },
    {
      "claim": "The result of an operation is a function of the two operands alone.",
      "status": "REFUTED",
      "evidence": "an extra PUSH_CONST before the operands changes the output (e.g. ADD 2+3 -> 0x05 becomes 0x54) and swapping the operands changes it (ADD 2+3 -> 0x05, ADD 3+2 -> 0x07)."
    },
    {
      "claim": "ADD is commutative on this image.",
      "status": "REFUTED",
      "evidence": "ADD 2+3 -> 0x05 while ADD 3+2 -> 0x07."
    },
    {
      "claim": "The image is a general-purpose arithmetic engine over byte operands.",
      "status": "REFUTED",
      "evidence": "the observed outcome alphabet is finite and tiny: ADD 5/25 (outcomes ['02', '05', '07']); SUB 4/25 (outcomes ['00', '01', '02']); the source selects the result with a few flags and materialises it with fixed ROT constants, so the operand magnitude does not enter the result."
    },
    {
      "claim": "The milestone vectors recorded in the evidence bundle still reproduce exactly (outputs and step counts).",
      "status": "DEMONSTRATED",
      "evidence": "14/14 controls reproduce the recorded step count."
    }
  ],
  "scope_limits": [
    "The grid covers single-byte operands in {0..4}^2; operands outside that range are NOT measured.",
    "Only ADD (0x02) and SUB (0x03) are measured. CMP_EQ (0x04), MUL and DIV are not exercised by this harness.",
    "The harness measures the observable byte emitted by OUT_BYTE; it does not trace the internal state of the two stack slots.",
    "SUB with a < b is reported as NOT_COMPARABLE: the milestone documents the underflow into the Malbolge modulus (59049) and this harness does not model the wrapped value.",
    "A divergence from integer arithmetic is a statement about the image under test, not about the MBIR design or about the possibility of a correct arithmetic kernel."
  ],
  "not_demonstrated": [
    "A general-purpose ADD/SUB over byte operands (the image under test does not compute the sum or the difference).",
    "The correct wrapped result of SUB with a < b.",
    "Whether the same table-backed behaviour is shared by the other MBIR images (stored-program ALU, comparators) -- each image must be measured on its own.",
    "Whether a rewritten kernel can implement real arithmetic inside the same byte budget; this harness measures, it does not design."
  ],
